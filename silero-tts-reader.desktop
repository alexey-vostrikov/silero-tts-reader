[Desktop Entry]
Name=Silero TTS Reader
GenericName=Text to Speech Reader
Comment=Read selected text aloud using Silero TTS
Exec=silero-tts-reader %f
Icon=silero-tts-reader
Terminal=false
Type=Application
Categories=Accessibility;Utility;
MimeType=text/plain;application/x-fictionbook+xml;application/x-zip-compressed-fb2;
Keywords=tts;text;speech;silero;read;book;fb2;
StartupNotify=false
StartupWMClass=ru.skala.silero-tts-reader
X-GNOME-Autostart-enabled=true
X-GNOME-UsesNotifications=true
